import requests
from bs4 import BeautifulSoup
import csv

class BookScraper:
    def __init__(self):
        # Initialize the base URL for book scraping
        self.base_url = 'https://books.toscrape.com/catalogue/'

    def scrape_book_details(self, url):
        # Function to scrape book details from a given URL
        response = requests.get(url)
        soup = BeautifulSoup(response.content, 'html.parser')
        book_details = []

        # Iterate through each book in the HTML response
        for book in soup.find_all('article', class_='product_pod'):
            # Extract relevant information for each book
            title = book.h3.a.get('title')
            price = book.find('p', class_='price_color').get_text()
            availability = book.find('p', class_='instock availability').get_text().strip()
            image_url = book.img.get('src')
            rating = book.find('p', class_='star-rating')['class'][1]
            product_page_url = book.h3.a.get('href')

            # Create a dictionary with book information and add it to the list
            book_info = {
                'Title': title,
                'Price': price,
                'Availability': availability,
                'Image URL': image_url,
                'Rating': rating,
                'Product Page URL': f'{self.base_url}{product_page_url}'
            }
            book_details.append(book_info)

        return book_details

    def write_to_csv(self, data, filename):
        # Function to write book details to a CSV file
        keys = data[0].keys() if data else []
        with open(filename, 'w', newline='', encoding='utf-8') as csv_file:
            writer = csv.DictWriter(csv_file, fieldnames=keys)
            writer.writeheader()
            writer.writerows(data)

    def scrape_books_for_category(self, category):
        # Function to scrape books for a specific category
        url = f'{self.base_url}category/books/{category}/index.html'
        print(f"URL for '{category}' category: {url}")

        book_data = []
        page_number = 1
        total_columns = 0

        # Iterate through pages until total_columns >= 100
        while total_columns < 100:
            page_url = f"{url}?page={page_number}"
            # Get book details for the specified category and page
            page_data = self.scrape_book_details(page_url)
            book_data.extend(page_data)
            total_columns += len(page_data)

            # Increment page number for the next iteration
            page_number += 1

        # Trim the excess columns to reach exactly 100
        if total_columns > 100:
            excess = total_columns - 100
            book_data = book_data[:-excess]

        # Create a CSV file with the scraped book details
        filename = f'{category}_books.csv'
        self.write_to_csv(book_data, filename)
        print(f"Books data for '{category}' category has been saved in '{filename}'.")

# Example usage
scraper = BookScraper()
categories = ['fiction_10', 'science-fiction_16', 'historical-fiction_4']
for category in categories:
    scraper.scrape_books_for_category(category)

